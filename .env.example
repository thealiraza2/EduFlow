# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academyhub?schema=public"

# Auth.js (NextAuth v5)
NEXTAUTH_SECRET="change-me-to-a-secure-random-string-min-32-chars"
