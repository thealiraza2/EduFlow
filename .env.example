# ==============================================================================
# AcademyHub Environment Configuration Template
# NOTE: NEVER commit your actual .env file or real credentials to source control.
# Copy this file to .env (`cp .env.example .env`) and fill in your values.
# ==============================================================================

# Database (PostgreSQL 16)
# Local: postgresql://postgres:postgres@localhost:5432/academyhub?schema=public
# Production (Supabase): Transaction pooler URI on port 6543 with ?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/academyhub?schema=public"

# Auth.js (NextAuth v5)
# Generate a secure 32+ character random string using: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-secure-random-string-min-32-chars"
NEXTAUTH_SECRET="change-me-to-a-secure-random-string-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# QR Attendance Cryptographic HMAC Secret (Phase 14 & Security Hardening)
# Dedicated key for signing 10-minute student QR attendance tokens (one key, one purpose)
# Generate with: openssl rand -hex 32
QR_HMAC_SECRET="change-me-to-a-secure-random-hex-string-min-32-chars"

# Notifications (SMS / WhatsApp)
# SMS_PROVIDER: "log" (default, writes to DB NotificationLog table) or "whatsapp"
SMS_PROVIDER="log"
# SMS_API_KEY: Obtained from your local Pakistani telco SMS aggregator
SMS_API_KEY=""

# JazzCash Mobile Wallet (Phase 11: 100% functional Sandbox mode)
# Live mode requires an approved merchant account from Mobilink Microfinance Bank
# Credentials obtained from JazzCash Merchant Portal (https://sandbox.jazzcash.com.pk)
JAZZCASH_MERCHANT_ID="MC12345_SANDBOX"
JAZZCASH_PASSWORD="sandbox_password_123"
JAZZCASH_INTEGRITY_SALT="sandbox_salt_secret_9876543210"
JAZZCASH_RETURN_URL="http://localhost:3000/api/webhooks/jazzcash"
JAZZCASH_SANDBOX_URL="http://localhost:3000/sandbox/checkout/jazzcash"

# Easypaisa Mobile Wallet (Phase 11: 100% functional Sandbox mode)
# Live mode requires an approved merchant account from Telenor Microfinance Bank
# Credentials obtained from Easypaisa Developer Portal (https://easypay.easypaisa.com.pk)
EASYPAISA_STORE_ID="12345"
EASYPAISA_HASH_KEY="easypaisa_sandbox_hash_key_12345"
EASYPAISA_RETURN_URL="http://localhost:3000/api/webhooks/easypaisa"
EASYPAISA_SANDBOX_URL="http://localhost:3000/sandbox/checkout/easypaisa"

# AI Analytics & LLM Integration (Phase 13: Invariant 12 - deterministic code decides, LLM only words)
# Get a free API key from Groq Console: https://console.groq.com/keys
# If omitted, features gracefully degrade ("AI unavailable — showing data only")
LLM_API_KEY=""
LLM_MODEL="llama-3.1-70b-versatile"
LLM_ENDPOINT="https://api.groq.com/openai/v1/chat/completions"

# Meta WhatsApp Business Cloud API (Phase 14: Meta Cloud API Driver & Inbound Bot Webhook)
# Obtained from Meta for Developers (https://developers.facebook.com) -> App Dashboard -> WhatsApp
# Default driver stays LOG until Meta business verification is complete.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="academyhub_wa_verify_token_secret"
WHATSAPP_APP_SECRET="whatsapp_app_secret_12345"
