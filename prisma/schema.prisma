// EduFlow - Core Database Schema
// PostgreSQL 16 via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum QuestionType {
  MCQ
  SHORT
  LONG
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum AcademyPlan {
  FREE
  STARTER
  GROWTH
  PRO
}

enum AcademyStatus {
  ACTIVE
  SUSPENDED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  LEFT
  STRUCK_OFF
}

enum EnrollmentStatus {
  ACTIVE
  LEFT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  JAZZCASH
  EASYPAISA
  BANK
}

enum TestStatus {
  DRAFT
  PUBLISHED
}

enum NotificationChannel {
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum NotificationTrigger {
  ABSENCE
  FEE_REMINDER
  RESULT
  CUSTOM
}

enum SalaryStatus {
  UNPAID
  PAID
}

enum AnnouncementAudience {
  ALL
  TEACHERS
  PARENTS
}

model Academy {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  subdomain   String?       @unique
  plan        AcademyPlan   @default(PRO)
  status      AcademyStatus @default(ACTIVE)
  trialEndsAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users           User[]
  teachers        Teacher[]
  students        Student[]
  classes         Class[]
  batches         Batch[]
  enrollments     Enrollment[]
  attendances     Attendance[]
  feePlans        FeePlan[]
  feeInvoices     FeeInvoice[]
  feePayments     FeePayment[]
  tests           Test[]
  testResults     TestResult[]
  questions       Question[]
  testAttempts    TestAttempt[]
  studentAnswers  StudentAnswer[]
  notifications   NotificationLog[]
  timetableSlots  TimetableSlot[]
  teacherSalaries TeacherSalary[]
  announcements   Announcement[]
  savedPapers     SavedPaper[]

  @@index([slug])
  @@index([status])
}

model User {
  id                 String   @id @default(cuid())
  academyId          String?
  academy            Academy? @relation(fields: [academyId], references: [id], onDelete: Cascade)
  email              String   @unique
  passwordHash       String
  role               Role
  name               String
  phone              String?
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  teacher  Teacher?
  children Student[] @relation("ParentGuardianUser")
  student  Student?  @relation("StudentUser")

  @@index([academyId])
}

model Teacher {
  id          String        @id @default(cuid())
  academyId   String
  academy     Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects    String[] // e.g. ["Maths", "Physics"]
  salaryMinor Int // Salary in minor units (paisa)
  joiningDate DateTime      @default(now())
  status      TeacherStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  batches        Batch[]
  timetableSlots TimetableSlot[]
  salaries       TeacherSalary[]

  @@index([academyId])
}

model Student {
  id             String        @id @default(cuid())
  academyId      String
  academy        Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  admissionNo    String
  name           String
  guardianName   String
  guardianPhone  String
  guardianUserId String?
  guardianUser   User?         @relation("ParentGuardianUser", fields: [guardianUserId], references: [id], onDelete: SetNull)
  userId         String?       @unique
  user           User?         @relation("StudentUser", fields: [userId], references: [id], onDelete: SetNull)
  dateOfBirth    DateTime?
  address        String?
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  enrollments   Enrollment[]
  invoices      FeeInvoice[]
  testResults   TestResult[]
  attempts      TestAttempt[]
  notifications NotificationLog[]

  @@unique([academyId, admissionNo])
  @@index([academyId])
  @@index([guardianPhone])
  @@index([guardianUserId])
}

model Class {
  id        String   @id @default(cuid())
  academyId String
  academy   Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  name      String // e.g. "9th", "10th"
  section   String // e.g. "A", "B"
  capacity  Int      @default(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches Batch[]

  @@unique([academyId, name, section])
  @@index([academyId])
}

model Batch {
  id        String   @id @default(cuid())
  academyId String
  academy   Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String // e.g. "Evening Batch"
  timing    String // e.g. "4-6 PM"
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  feeMinor  Int // Base fee in paisa
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feePlan        FeePlan?
  enrollments    Enrollment[]
  invoices       FeeInvoice[]
  tests          Test[]
  timetableSlots TimetableSlot[]

  @@index([academyId])
  @@index([classId])
  @@index([teacherId])
}

model TimetableSlot {
  id        String   @id @default(cuid())
  academyId String
  academy   Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String // e.g. "16:00"
  endTime   String // e.g. "17:00"
  subject   String // e.g. "Maths"
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  room      String? // e.g. "Room 101"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academyId, batchId, dayOfWeek, startTime])
  @@index([academyId])
  @@index([batchId])
  @@index([teacherId])
  @@index([dayOfWeek])
}

model Enrollment {
  id         String           @id @default(cuid())
  academyId  String
  academy    Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batchId    String
  batch      Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  enrolledAt DateTime         @default(now())
  status     EnrollmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  attendance Attendance[]

  @@unique([academyId, studentId, batchId])
  @@unique([studentId, batchId])
  @@index([academyId])
  @@index([batchId])
}

model Attendance {
  id           String           @id @default(cuid())
  academyId    String
  academy      Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  status       AttendanceStatus
  remarks      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([academyId, enrollmentId, date])
  @@unique([enrollmentId, date])
  @@index([academyId])
  @@index([date])
}

model FeePlan {
  id                String   @id @default(cuid())
  academyId         String
  academy           Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  batchId           String   @unique
  batch             Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  monthlyFeeMinor   Int // in paisa
  admissionFeeMinor Int      @default(0) // in paisa
  lateFineMinor     Int      @default(0) // in paisa
  dueDayOfMonth     Int      @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([academyId])
}

model FeeInvoice {
  id            String        @id @default(cuid())
  academyId     String
  academy       Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batchId       String
  batch         Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  month         String // "YYYY-MM"
  amountMinor   Int // Monthly fee in paisa
  discountMinor Int           @default(0) // Discount in paisa
  fineMinor     Int           @default(0) // Late fine in paisa
  totalMinor    Int // (amount + fine) - discount in paisa
  status        InvoiceStatus @default(UNPAID)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payments FeePayment[]

  @@unique([academyId, studentId, batchId, month])
  @@unique([studentId, batchId, month])
  @@index([academyId])
  @@index([studentId])
  @@index([batchId])
  @@index([status])
}

model FeePayment {
  id                   String        @id @default(cuid())
  academyId            String
  academy              Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  invoiceId            String
  invoice              FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountMinor          Int // in paisa (append-only)
  method               PaymentMethod @default(CASH)
  receivedBy           String // User ID or name of staff / Gateway
  gatewayTransactionId String?       @unique
  rawGatewayPayload    String? // JSON serialized callback data for audit
  paidAt               DateTime      @default(now())
  createdAt            DateTime      @default(now())

  @@index([academyId])
  @@index([invoiceId])
  @@index([gatewayTransactionId])
}

model Test {
  id               String       @id @default(cuid())
  academyId        String
  academy          Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  batchId          String
  batch            Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject          String // e.g. "Maths"
  title            String // e.g. "Chapter 1 Test"
  totalMarks       Int
  date             DateTime     @db.Date
  status           TestStatus   @default(DRAFT)
  publishedAt      DateTime?
  durationMinutes  Int? // Duration in minutes for online test
  negativeMarking  Float        @default(0) // Marks deducted per wrong MCQ (e.g. 0.25)
  shuffleQuestions Boolean      @default(false)
  isClosed         Boolean      @default(false) // Leaderboard published only after close
  closedAt         DateTime?
  schemeId         String?
  scheme           PaperScheme? @relation(fields: [schemeId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  results   TestResult[]
  questions Question[]
  attempts  TestAttempt[]

  @@index([academyId])
  @@index([batchId])
  @@index([status])
  @@index([schemeId])
}

model Question {
  id            String       @id @default(cuid())
  academyId     String
  academy       Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  testId        String
  test          Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  type          QuestionType @default(MCQ)
  text          String
  options       Json? // Array of options, e.g. ["A", "B", "C", "D"]
  correctAnswer String
  marks         Float        @default(1.0)
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  studentAnswers StudentAnswer[]

  @@index([academyId])
  @@index([testId])
}

model TestAttempt {
  id             String        @id @default(cuid())
  academyId      String
  academy        Academy       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  testId         String
  test           Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt      DateTime      @default(now())
  submittedAt    DateTime?
  score          Float         @default(0)
  scoreMinor     Int           @default(0)
  status         AttemptStatus @default(IN_PROGRESS)
  tabSwitchCount Int           @default(0) // Anti-cheat blur/switch counter
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  answers StudentAnswer[]

  @@unique([testId, studentId])
  @@index([academyId])
  @@index([testId])
  @@index([studentId])
}

model StudentAnswer {
  id           String      @id @default(cuid())
  academyId    String
  academy      Academy     @relation(fields: [academyId], references: [id], onDelete: Cascade)
  attemptId    String
  attempt      TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer       String
  isCorrect    Boolean? // null for SHORT questions until marked by teacher
  marksAwarded Float       @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([attemptId, questionId])
  @@index([academyId])
  @@index([attemptId])
  @@index([questionId])
}

model TestResult {
  id            String   @id @default(cuid())
  academyId     String
  academy       Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  testId        String
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  obtainedMarks Float
  remarks       String?
  correctionLog String? // Stores reason & history if corrected after publishing
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([academyId, testId, studentId])
  @@unique([testId, studentId])
  @@index([academyId])
  @@index([studentId])
}

model NotificationLog {
  id             String              @id @default(cuid())
  academyId      String
  academy        Academy             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  recipientPhone String
  recipient      String?
  channel        NotificationChannel @default(SMS)
  template       String              @default("ABSENCE_NOTIFICATION")
  message        String
  status         NotificationStatus  @default(QUEUED)
  sentAt         DateTime?
  studentId      String?
  student        Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)
  trigger        NotificationTrigger @default(CUSTOM)
  referenceId    String?
  createdAt      DateTime            @default(now())

  @@unique([referenceId])
  @@index([academyId])
  @@index([recipientPhone])
  @@index([status])
  @@index([studentId])
  @@index([trigger])
  @@index([referenceId])
}

model TeacherSalary {
  id          String       @id @default(cuid())
  academyId   String
  academy     Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  month       String // "YYYY-MM"
  amountMinor Int // in paisa
  status      SalaryStatus @default(UNPAID)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([academyId, teacherId, month])
  @@unique([teacherId, month])
  @@index([academyId])
  @@index([month])
  @@index([status])
}

model Announcement {
  id        String               @id @default(cuid())
  academyId String
  academy   Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  title     String
  content   String
  audience  AnnouncementAudience @default(ALL)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([academyId])
  @@index([audience])
  @@index([createdAt])
}

model Board {
  id        String        @id @default(cuid())
  name      String        @unique // e.g. "BISE Lahore"
  province  String // e.g. "Punjab"
  subjects  Subject[]
  schemes   PaperScheme[]
  createdAt DateTime      @default(now())
}

model Subject {
  id        String        @id @default(cuid())
  boardId   String
  board     Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  className String // e.g. "9th", "10th"
  name      String // e.g. "Physics"
  chapters  Chapter[]
  schemes   PaperScheme[]
  createdAt DateTime      @default(now())

  @@unique([boardId, className, name])
}

model Chapter {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  createdAt DateTime @default(now())

  @@unique([subjectId, number])
}

model PaperScheme {
  id          String    @id @default(cuid())
  boardId     String
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  className   String
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  // e.g. { "mcq": { "count": 12, "marksEach": 1 }, "short": { "count": 9, "marksEach": 2, "attempt": 6 }, "long": { "count": 3, "marksEach": 5, "attempt": 2 } }
  structure   Json
  totalMarks  Int
  timeMinutes Int?
  sourceUrl   String? // link to the board's official pairing-scheme document
  verified    Boolean   @default(false)
  verifiedAt  DateTime?
  notes       String? // e.g. "PARTIAL: short/long breakdown unconfirmed — see SOURCES.md"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tests Test[]

  @@unique([boardId, className, subjectId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  contact   String // phone or email
  message   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Question bank + paper builder (v2). Platform-wide content entered by the
// EduFlow team; every academy reads it. Organised by textbook EDITION so a new
// book never breaks old papers: Authority -> Book (edition) -> Unit -> Topic.
// ---------------------------------------------------------------------------

enum BankQuestionType {
  MCQ
  SHORT
  LONG
}

enum BankQuestionSource {
  EXERCISE
  PAST_PAPER
  ADDITIONAL
  CONCEPTUAL
}

enum ContentStatus {
  DRAFT
  REVIEWED
}

/// Body that publishes the textbooks, e.g. PECTA (Punjab), Sindh Textbook Board.
model TextbookAuthority {
  id        String      @id @default(cuid())
  code      String      @unique // "PECTA"
  name      String
  province  String
  createdAt DateTime    @default(now())
  books     Book[]
  boards    ExamBoard[]
}

/// Examining board, e.g. BISE Lahore. Uses the books of its authority.
model ExamBoard {
  id          String            @id @default(cuid())
  code        String            @unique // "BISE-LHR"
  name        String
  province    String
  authorityId String
  authority   TextbookAuthority @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  schemes     BoardScheme[]

  @@index([authorityId])
}

/// One edition of one textbook, e.g. PECTA 9th Physics, National Curriculum 2023.
model Book {
  id          String            @id @default(cuid())
  authorityId String
  authority   TextbookAuthority @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  className   String // "9", "10", "11", "12"
  subject     String // "Physics"
  subjectUr   String? // "طبیعیات"
  edition     String // "National Curriculum 2023"
  sessionFrom Int // first session the edition is taught, e.g. 2025
  isCurrent   Boolean           @default(true)
  sourceUrl   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  units     BookUnit[]
  questions BankQuestion[]
  schemes   BoardScheme[]
  papers    SavedPaper[]

  @@unique([authorityId, className, subject, edition])
  @@index([className, subject, isCurrent])
}

model BookUnit {
  id        String         @id @default(cuid())
  bookId    String
  book      Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  titleUr   String?
  topics    BookTopic[]
  questions BankQuestion[]

  @@unique([bookId, number])
}

model BookTopic {
  id        String         @id @default(cuid())
  unitId    String
  unit      BookUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  code      String // "1.2"
  title     String
  titleUr   String?
  order     Int            @default(0)
  questions BankQuestion[]

  @@unique([unitId, code])
}

model BankQuestion {
  id           String             @id @default(cuid())
  bookId       String
  book         Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  unitId       String
  unit         BookUnit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topicId      String?
  topic        BookTopic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  type         BankQuestionType
  source       BankQuestionSource @default(EXERCISE)
  textEn       String?
  textUr       String?
  /// MCQ options: [{ "en": "...", "ur": "..." }, ...]
  options      Json?
  /// MCQ: index of the correct option (0-3). Other types: model answer text.
  answer       String?
  marks        Float              @default(1)
  /// LONG question parts: [{ "label": "a", "en": "...", "ur": "...", "marks": 4 }]
  parts        Json?
  imageUrl     String?
  pastPaperRef String? // "BISE Lahore 2024, Group I"
  status       ContentStatus      @default(DRAFT)
  createdById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([bookId, type, status])
  @@index([unitId])
  @@index([topicId])
}

/// Pairing scheme for one board (or all boards of an authority when examBoardId
/// is null) for one book in one session.
model BoardScheme {
  id          String     @id @default(cuid())
  bookId      String
  book        Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  examBoardId String?
  examBoard   ExamBoard? @relation(fields: [examBoardId], references: [id], onDelete: Cascade)
  session     Int // 2026
  title       String
  totalMarks  Int
  timeMinutes Int?
  /// [{ "type": "MCQ", "label": "Q.1", "required": 12, "choice": 12, "marksEach": 1,
  ///    "quota": [{ "unit": 1, "count": 2 }, ...] }, ...]
  structure   Json
  sourceUrl   String?
  verified    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([bookId, session])
}

/// A paper a teacher built. `sections` holds question ids plus per-paper edits.
model SavedPaper {
  id          String   @id @default(cuid())
  academyId   String
  academy     Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  createdById String
  bookId      String?
  book        Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)
  title       String
  className   String
  subject     String
  totalMarks  Int
  timeMinutes Int?
  language    String   @default("dual") // "en" | "ur" | "dual"
  sections    Json
  settings    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([academyId])
  @@index([createdById])
}
